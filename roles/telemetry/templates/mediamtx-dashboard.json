      "options": {
        "mode": "html",
        "content": "{% endraw %}<div id=\"slot-grid\" style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:8px\"></div><script>(function(){var base='https://{{ web_proxy__domain }}';var slots=['x/slot1','x/slot2','x/slot3','x/slot4','x/slot5','x/slot6','x/slot7','x/slot8'];var isChrome=/Chrome/.test(navigator.userAgent)&&!/Edg/.test(navigator.userAgent);var grid=document.getElementById('slot-grid');slots.forEach(function(s){var c=document.createElement('div');c.style.textAlign='center';if(isChrome){c.innerHTML='<div style=\"position:relative\"><iframe src=\"'+base+'/webrtc/'+s+'\" style=\"width:100%;aspect-ratio:16/9;border:none;border-radius:4px\" allow=\"autoplay\"></iframe><a href=\"'+base+'/webrtc/'+s+'\" target=\"_blank\" style=\"position:absolute;inset:0\"></a></div><div style=\"margin-top:4px;font-size:12px\">'+s+' (webrtc)</div>';}else{var img=base+'/snapshots/'+s+'.jpg';c.innerHTML='<div><img src=\"'+img+'\" style=\"width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:4px;background:#111\"></div><div style=\"margin-top:4px;font-size:12px\">'+s+' (snapshot)</div>';}grid.appendChild(c);});if(!isChrome){setInterval(function(){grid.querySelectorAll('img').forEach(function(img){img.src=img.src.split('?')[0]+'?t='+Date.now();});},10000);}})()</script>{% raw %}"
