{
    metrics {
        per_host
    }
}

# Reusable SSO gate: forward_auth to oauth2-proxy, then require the caller's
# X-Auth-Request-Groups header to match the group regex passed as the first
# snippet argument. Casdoor groups are namespaced "{{ auth__org }}/<name>";
# new users (Google or manual) start in none of them until an admin adds
# them via the Casdoor Groups page — see roles/auth/README.md.
(require_group) {
    forward_auth localhost:{{ auth__oauth2_proxy_port | default(4180) }} {
        uri /oauth2/auth
        header_up X-Real-IP {remote_host}
        copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Groups
        @unauth status 401
        handle_response @unauth {
            redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
        }
    }
    @no_group not header_regexp X-Auth-Request-Groups "{args[0]}"
    respond @no_group 403
}

(require_stream_group) {
    import require_group (^|,){{ auth__org }}/(admin|production)(,|$)
}

(require_gfx_group) {
    import require_group (^|,){{ auth__org }}/(admin|gfx)(,|$)
}

http://localhost:2019 {
    metrics
}

auth.{{ web_proxy__domain }} {
{% if web_proxy__disable_tls | default(false) %}
    tls internal
{% endif %}
    reverse_proxy localhost:{{ auth__casdoor_port | default(8000) }}
}

{{ web_proxy__domain }} {
{% if web_proxy__disable_tls | default(false) %}
    tls internal
{% endif %}

    # oauth2-proxy endpoints — public (must come first)
    handle /oauth2/* {
        reverse_proxy localhost:{{ auth__oauth2_proxy_port | default(4180) }}
    }

    # HLS / WebRTC playback — admin or production group
    handle_path /hls/* {
        import require_stream_group
        reverse_proxy {
            to localhost:8888
            header_down Location ^/ /hls/
        }
    }
    handle_path /webrtc/* {
        import require_stream_group
        reverse_proxy {
            to localhost:8889
            header_down Location ^/ /webrtc/
        }
    }
    handle_path /oresults/* {
        @cors_preflight method OPTIONS
        @allowed_origin header_regexp origin Origin ^(https://thejoeejoee\.github\.io|http://localhost(:\d+)?)$

        header @allowed_origin Access-Control-Allow-Origin "{http.request.header.Origin}"
        header @allowed_origin Access-Control-Allow-Methods "GET, OPTIONS"
        header @allowed_origin Access-Control-Allow-Headers "Content-Type"

        handle @cors_preflight {
            respond 204
        }

        reverse_proxy https://cdn.oresults.eu {
            header_up Host cdn.oresults.eu
            header_down -Access-Control-Allow-Origin
        }
    }

    handle_path /snapshots/* {
        root * /var/mediamtx/snapshots
        file_server
    }

    # Prometheus — admin only, do not strip /prometheus
    handle /prometheus/* {
        import require_group (^|,){{ auth__org }}/admin(,|$)
        reverse_proxy localhost:9090
    }

    # Grafana — native OIDC via Casdoor (see roles/telemetry), no forward_auth
    handle_path /grafana/* {
        reverse_proxy localhost:3000
    }

    handle {
        header Content-Type "text/html; charset=utf-8"
        respond <<HTML
        <!doctype html>
        <html lang="en">
        <head>
            <meta charset="utf-8">
            <meta name="viewport" content="width=device-width, initial-scale=1">
            <title>{{ web_proxy__domain }}</title>
            <style>
                body { font-family: system-ui, sans-serif; max-width: 480px; margin: 4rem auto; padding: 0 1rem; color: #1a1a1a; }
                h1 { font-size: 1.4rem; margin-bottom: 2rem; }
                ul { list-style: none; padding: 0; }
                li { margin: .5rem 0; }
                a { color: #0055d4; text-decoration: none; }
                a:hover { text-decoration: underline; }
                small { color: #666; }
            </style>
        </head>
        <body>
            <h1>{{ web_proxy__domain }}</h1>
            <ul>
                <li><a href="/grafana/">Grafana</a> <small>— monitoring dashboards</small></li>
                <li><a href="/prometheus/">Prometheus</a> <small>— metrics</small></li>
                <li><a href="/hls/">HLS player</a> <small>— stream playback</small></li>
                <li><a href="https://gfx.{{ web_proxy__domain }}/">GFX Control</a> <small>— graphics control panel</small></li>
                <li><a href="{{ gfx__github_pages_url }}">GFX Overlay</a> <small>— stream overlay (GitHub Pages)</small></li>
            </ul>
            <h2 style="font-size:1rem;margin-top:2rem;">OBS Browser Source</h2>
            <input readonly value="{{ gfx__github_pages_url }}?sse=https://gfx.{{ web_proxy__domain }}/_sse/" onclick="this.select()" style="width:100%;padding:.4rem;font:inherit;font-size:.85rem;border:1px solid #ccc;border-radius:4px;color:#333;background:#f8f8f8;cursor:text;"
            >
        </body>
        </html>
        HTML
    }
}

# allow cloud connection with hardcoded http:// in TallyArbiter
cloud.ta.{{ web_proxy__domain }}:80, socket.tally.{{ web_proxy__domain }}:80 {
{% if web_proxy__disable_tls | default(false) %}
    tls internal
{% endif %}
    reverse_proxy localhost:4455
}

ta.{{ web_proxy__domain }}, tally.{{ web_proxy__domain }} {
{% if web_proxy__disable_tls | default(false) %}
    tls internal
{% endif %}
    reverse_proxy localhost:4455
}

gfx.{{ web_proxy__domain }} {
{% if web_proxy__disable_tls | default(false) %}
    tls internal
{% endif %}
    handle /_sse/* {
        reverse_proxy localhost:{{ gfx__proxy_host_port }} {
            flush_interval -1
        }
    }

    handle /api/director-favorite {
        @post method POST
        handle @post {
            import require_gfx_group
        }
        reverse_proxy localhost:{{ gfx__control_host_port }}
    }

    handle {
        import require_gfx_group
        reverse_proxy localhost:{{ gfx__control_host_port }}
    }
}
