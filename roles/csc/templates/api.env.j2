CSC_DATABASE_URL=postgresql+asyncpg://{{ credentials.csc_db.user }}:{{ credentials.csc_db.pass }}@host.docker.internal:{{ csc__db_port }}/{{ credentials.csc_db.name }}
CSC_DB_POOL_SIZE=20
CSC_PROXY_AUTH_ENABLED=false
CSC_LOG_LEVEL={{ csc__log_level }}
# Admin is now same-origin with the API (both under csc.HOST), so it doesn't need CORS.
# Only gfx (at gfx.csc.HOST) makes cross-origin calls to csc.HOST/api/gfx/stream/*.
CSC_CORS_ORIGINS=["https://gfx.csc.{{ web_proxy__domain }}"]
CSC_CORS_ORIGIN_REGEX=
CSC_GFX_BASE_URL=https://gfx.csc.{{ web_proxy__domain }}
