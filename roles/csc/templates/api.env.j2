CSC_DATABASE_URL=postgresql+asyncpg://{{ credentials.csc_db.user }}:{{ credentials.csc_db.pass }}@host.docker.internal:{{ csc__db_port }}/{{ credentials.csc_db.name }}
CSC_DB_POOL_SIZE=20
CSC_PROXY_AUTH_ENABLED=false
CSC_LOG_LEVEL={{ csc__log_level }}
# Admin is now same-origin with the API (both under csc.HOST), so it doesn't need CORS.
# Only gfx (at gfx.csc.HOST) makes cross-origin calls to csc.HOST/api/gfx/stream/*.
CSC_CORS_ORIGINS=["https://gfx.csc.{{ web_proxy__domain }}"]
CSC_CORS_ORIGIN_REGEX=
CSC_GFX_BASE_URL=https://gfx.csc.{{ web_proxy__domain }}

# ADR-046: on-disk heightmap cache for course_route_choices_3d. Persisted
# via the ``heightmap_cache`` named volume (mounted at the same path)
# so operator re-fires after api restarts don't rebuild from the DEM.
CSC_HEIGHTMAP_CACHE_DIR={{ csc__heightmap_cache_dir }}

{% if csc__dmr5g_enabled %}
# ADR-044: self-hosted OpenTopoData instance in the compose stack.
# Docker DNS routes ``otd`` to the OTD container. When unreachable the
# DMR 5G adapter cascades to Copernicus GLO-30 (same behaviour as if
# CSC_OTD_BASE_URL is unset).
CSC_OTD_BASE_URL=http://otd:5000/v1
# ADR-046 slice 2.5: direct rasterio read of the DMR 5G VRT via the
# shared ``otd_tiles`` volume (mounted read-only on the api container).
# Skips the OTD HTTP hop entirely for heightmap builds on CZE events.
CSC_DMR5G_VRT_PATH=/data/dmr5g/vrt/dmr5g.vrt
{% else %}
# ADR-044 stack disabled — DMR 5G cascade falls through to Copernicus GLO-30.
# CSC_OTD_BASE_URL and CSC_DMR5G_VRT_PATH intentionally unset.
{% endif %}
