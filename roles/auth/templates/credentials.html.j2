<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ web_proxy__domain }} — Stream Credentials</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; }
        h1 { margin-bottom: 1rem; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
        .card { border: 1px solid #ddd; border-radius: 8px; padding: 1rem; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
        .card h2 { margin: 0 0 .75rem; font-size: 1.1rem; }
        .field { margin: .75rem 0; }
        .field label { display: block; font-size: .85rem; font-weight: 600; margin-bottom: .25rem; }
        .row { display: flex; gap: .5rem; }
        input { flex: 1; min-width: 0; padding: .45rem .55rem; font: inherit; font-size: .85rem; border: 1px solid #ccc; border-radius: 4px; color: #333; background: #f8f8f8; }
        button { padding: .45rem .7rem; border: 1px solid #ccc; border-radius: 4px; background: #fff; cursor: pointer; white-space: nowrap; }
        button:hover { background: #f3f3f3; }
        small { color: #666; }
        footer { margin-top: 1.5rem; }
    </style>
</head>
<body>
    <h1>Stream Credentials</h1>

    {% set slots = ['macos', 'slot1', 'slot2', 'slot3', 'slot4', 'slot5', 'slot6', 'slot7', 'slot8', 'demo'] %}
    <div class="grid">
    {% for slot in slots %}
        <section class="card">
            <h2>{{ slot }}</h2>

            <div class="field">
                <label>RTMP Ingest</label>
                <div class="row">
                    <input readonly value="rtmp://{{ web_proxy__domain }}:1935/x/{{ slot }}?user={{ credentials.stream_write[0].user }}&pass={{ credentials.stream_write[0].pass }}">
                    <button type="button" onclick="navigator.clipboard.writeText(this.previousElementSibling.value)">📋 Copy</button>
                </div>
            </div>

            <div class="field">
                <label>SRT Ingest</label>
                <div class="row">
                    <input readonly value="srt://{{ web_proxy__domain }}:8890?streamid=publish:x/{{ slot }}:{{ credentials.stream_write[0].user }}:{{ credentials.stream_write[0].pass }}">
                    <button type="button" onclick="navigator.clipboard.writeText(this.previousElementSibling.value)">📋 Copy</button>
                </div>
            </div>

            <div class="field">
                <label>HLS Viewer</label>
                <div class="row">
                    <input readonly value="https://{{ web_proxy__domain }}/hls/x/{{ slot }}/">
                    <button type="button" onclick="navigator.clipboard.writeText(this.previousElementSibling.value)">📋 Copy</button>
                </div>
            </div>

            <div class="field">
                <label>SRT Read</label>
                <div class="row">
                    <input readonly value="srt://{{ web_proxy__domain }}:8890?streamid=read:x/{{ slot }}:{{ credentials.stream_read[0].user }}:{{ credentials.stream_read[0].pass }}">
                    <button type="button" onclick="navigator.clipboard.writeText(this.previousElementSibling.value)">📋 Copy</button>
                </div>
            </div>
        </section>
    {% endfor %}
    </div>

    <footer><small>Authenticated users only — do not share this page</small></footer>
</body>
</html>
