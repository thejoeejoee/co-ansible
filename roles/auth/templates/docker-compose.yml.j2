services:
  casdoor:
    image: {{ auth__casdoor_image }}
    environment:
      RUNNING_IN_DOCKER: "true"
      driverName: sqlite
      dataSourceName: "file:/data/casdoor.db?cache=shared"
      origin: "https://{{ auth__domain }}"
      originFrontend: "https://{{ auth__domain }}"
      isDemoMode: "false"
      aiAssistantUrl: "{{ auth__ai_assistant_url }}"
    volumes:
      - "{{ auth__home_dir }}/data:/data"
    ports:
      - "127.0.0.1:{{ auth__casdoor_port }}:8000"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:8000/api/health"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 20s

  oauth2-proxy:
    image: {{ auth__oauth2_proxy_image }}
    command: --config=/etc/oauth2-proxy.cfg
    volumes:
      - "{{ auth__home_dir }}/oauth2-proxy.cfg:/etc/oauth2-proxy.cfg:ro"
    ports:
      - "127.0.0.1:{{ auth__oauth2_proxy_port }}:4180"
    depends_on:
      casdoor:
        condition: service_healthy
