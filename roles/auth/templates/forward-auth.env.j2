# casdoor-forward-auth uses CASDOOR_ENDPOINT for both its own server-to-server
# calls (token exchange, JWKS) and the browser's login redirect. Pointing it
# at the casdoor container keeps the former on the compose network — going
# out through the public https://{{ auth__domain }} hostname and back in
# through Caddy is unnecessary, and fails outright in OrbStack, where the
# self-signed cert gets rejected and there is no skip-verify option. Caddy
# rewrites the browser-facing redirect back to the public hostname (see the
# /_auth/* handler in roles/web_proxy/templates/Caddyfile.j2).
CASDOOR_ENDPOINT=http://casdoor:8000
CLIENT_ID='{{ auth__forward_auth_client_id }}'
CLIENT_SECRET='{{ auth__forward_auth_client_secret }}'
EXTERNAL_URL=https://{{ web_proxy__domain }}/_auth
COOKIE_DOMAIN={{ auth__cookie_domain }}
COOKIE_SECRET='{{ auth__forward_auth_cookie_secret }}'
SESSION_TTL={{ auth__forward_auth_session_ttl }}
